{
  "schema": "roco-artifact-registry/v1",
  "generated_by": "手工登记（结构性事实，不是生成物）",
  "why": "RC-104：规则/模式一变，哪些产物必须作废或重建，必须是**查得到的**，而不是靠人回想。每条产物声明它依赖哪些规则主题（rule topic），invalidation 脚本据此算出受影响清单。",
  "rules": [
    "每条 artifact 必须声明至少一个 depends_on（没有依赖的产物说明我们不知道它为什么对）。",
    "每个 rule topic 至少被一条 artifact 依赖（没人依赖的主题说明这张图漏了东西）。",
    "status=legacy 的产物**绑定旧规则**：在对应规则 candidate 被采纳前，禁止重跑生成（那只会再生产一批绑定旧规则的产物）。",
    "path 必须真的存在（或作为 glob 至少命中一个文件）——登记表不允许写想象中的路径。"
  ],
  "rule_topics": [
    {
      "id": "energy.max",
      "why": "能量上限：引擎假设 6，外部多源交叉支持 10（candidate）"
    },
    {
      "id": "energy.initial",
      "why": "入场初始能量：引擎假设 2，实机未定"
    },
    {
      "id": "energy.regen",
      "why": "回合末自然回能：引擎假设 +1，多源材料反驳"
    },
    {
      "id": "energy.charge",
      "why": "聚能：社区交叉支持 +5"
    },
    {
      "id": "turn_order.priority",
      "why": "应对/先手/换人/速度的严格总序：工程假设，需 microcase"
    },
    {
      "id": "turn_order.speed",
      "why": "速度与同速平手：平手判据 UNKNOWN"
    },
    {
      "id": "turn_order.end_turn",
      "why": "回合末结算顺序（DOT/特性/天气/回能/补位）"
    },
    {
      "id": "battle_mode.standard_pvp",
      "why": "标准 PVP：六宠、通常 4 魔力（CROSS_SOURCE_SUPPORTED）"
    },
    {
      "id": "battle_mode.speed_duel",
      "why": "极速对决：3v3、2 点魔力（OFFICIAL_CURRENT，独立模式）"
    },
    {
      "id": "battle_mode.territory_trial",
      "why": "领地试炼：2v2、特性共享、首领形态（官方公告）"
    },
    {
      "id": "type.multiplier",
      "why": "属性倍率 ×3/×2/×0.5/×0.25（COMMUNITY_CURRENT）"
    },
    {
      "id": "marks.persistence",
      "why": "印记下场不消失、入场继承、正负各一（COMMUNITY_CURRENT）"
    },
    {
      "id": "swift.injection",
      "why": "迅捷：主动换入时自动使用第一个满足能量且带迅捷的技能"
    },
    {
      "id": "leave.semantics",
      "why": "离场 = 主动更换或脱离效果，不含力竭下场"
    },
    {
      "id": "traits.triggers",
      "why": "特性触发语义（入场/离场/回合末/受击/克制后/队伍组成/能量上限突破…）"
    },
    {
      "id": "roster.universe",
      "why": "候选宇宙：全量 600+，还是某个固定名单"
    },
    {
      "id": "pvp.fairness",
      "why": "线上竞技不给战术分析等公平边界"
    },
    {
      "id": "turn_order.action_order",
      "why": "行动比较键的维度顺序（应对/先手/速度）：引擎假设，candidate 仍未确认"
    },
    {
      "id": "turn_order.speed_tie",
      "why": "速度平手：legacy 用随机数（工程权宜），candidate 为 UNKNOWN → fail closed"
    }
  ],
